# =============================================================================
# SatQuery AI — Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your deployment.
# All variables are prefixed with SATQUERY_ to avoid collisions.
#
# Documentation: https://github.com/aakash1552005/SatQuery-AI
# =============================================================================

# ---- Server ----
SATQUERY_HOST=0.0.0.0
SATQUERY_PORT=8000
SATQUERY_LOG_LEVEL=INFO
# SATQUERY_RELOAD=true  # Enable for development only

# ---- Security: API Key Authentication (GAP-01) ----
# Set an API key to require X-API-Key header on all /api/ endpoints.
# Leave commented out to disable authentication (development mode).
# SATQUERY_API_KEY=your-secure-api-key-here

# ---- Security: CORS Origins (GAP-01) ----
# Comma-separated list of allowed origins. Use '*' only for development.
SATQUERY_CORS_ORIGINS=*
# Production example:
# SATQUERY_CORS_ORIGINS=https://satquery-ai.aakash1552005.workers.dev,http://localhost:8000

# ---- Security: Rate Limiting (GAP-02) ----
SATQUERY_RATE_LIMIT_ENABLED=true
SATQUERY_RATE_LIMIT_UPLOAD=10/minute
SATQUERY_RATE_LIMIT_QUERY=30/minute
SATQUERY_RATE_LIMIT_DEFAULT=60/minute

# ---- Uploads (GAP-04, GAP-18) ----
SATQUERY_UPLOAD_DIR=data/uploads
SATQUERY_MAX_UPLOAD_SIZE_MB=50
SATQUERY_UPLOAD_TTL_HOURS=24
SATQUERY_ALLOWED_EXTENSIONS=.tif,.tiff,.geotiff,.png,.jpg,.jpeg

# ---- Cloud GPU Bridge (GAP-06) ----
# Pre-configured remote GPU worker URL (optional)
# SATQUERY_GPU_WORKER_URL=https://your-colab-worker.ngrok.io
# Shared secret for GPU worker registration endpoint
# SATQUERY_GPU_WORKER_SECRET=your-gpu-secret-here
